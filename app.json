{
  "expo": {
    "name": "uminoato-mobile",
    "slug": "uminoato-mobile",
    "scheme": "uminoato",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toruko83.uminoato",
      "associatedDomains": ["applinks:scubalab.vercel.app"]
    },
    "android": {
      "package": "com.toruko83.uminoato",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "scubalab.vercel.app",
              "pathPrefix": "/umi-no-ato"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E7AF0",
          "androidMode": "default",
          "androidCollapsedTitle": "#{unread_notifications} new notifications"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "コミュニティのアイコンや写真を選ぶために、写真ライブラリを使用します。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
